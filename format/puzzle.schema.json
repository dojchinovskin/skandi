{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dojchinovskin/skandi/format/puzzle.schema.json",
  "title": "Skandi puzzle, format 1",
  "description": "Structure only. The grid rules in format/README.md are checked by the generator's validate command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "number", "date", "width", "height", "grid", "clues", "pictures"],
  "properties": {
    "format": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "number": { "type": "integer", "minimum": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "width": { "type": "integer", "minimum": 3, "maximum": 30 },
    "height": { "type": "integer", "minimum": 3, "maximum": 30 },
    "grid": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "pattern": "^[АБВГДЃЕЖЗЅИЈКЛЉМНЊОПРСТЌУФХЦЧЏШ#*.]+$" }
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row", "col", "dir", "text"],
        "properties": {
          "row": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 },
          "dir": { "enum": ["across", "down"] },
          "text": { "type": "string", "minLength": 1 },
          "highlight": { "type": "boolean" }
        }
      }
    },
    "pictures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row", "col", "width", "height", "file", "alt", "credit"],
        "properties": {
          "row": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.(svg|png|jpg|webp)$" },
          "alt": { "type": "string", "minLength": 1 },
          "credit": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
